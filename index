        <section id="inscripcion">
            <h2>10. Formulario de inscripción estudiantil</h2>
            <p>
                Completa los campos de ejemplo. Este formulario es demostrativo:
                no almacena los datos en una base de datos ni cuenta con un servidor
                para procesarlos.
            </p>

            <form action="mailto:profesor@utp.ac.pa" method="post" enctype="text/plain">
                <fieldset>
                    <legend>Datos personales</legend>

                    <p>
                        <label for="nombre">Nombre:</label><br>
                        <input type="text" id="nombre" name="nombre" autocomplete="given-name" required>
                    </p>

                    <p>
                        <label for="apellido">Apellido:</label><br>
                        <input type="text" id="apellido" name="apellido" autocomplete="family-name" required>
                    </p>

                    <p>
                        <label for="correo">Correo electrónico:</label><br>
                        <input type="email" id="correo" name="correo" autocomplete="email" required>
                    </p>

                    <p>
                        <label for="fecha">Fecha de nacimiento:</label><br>
                        <input type="date" id="fecha" name="fecha_nacimiento" required>
                    </p>

                    <p>
                        <label for="cedula">Cédula:</label><br>
                        <input type="text" id="cedula" name="cedula"
                               placeholder="Ejemplo: 8-000-0000"
                               pattern="[0-9]+-[0-9]+-[0-9]+"
                               title="Escribe la cédula en el formato 8-000-0000"
                               required>
                    </p>
                </fieldset>

                <fieldset>
                    <legend>Información académica</legend>

                    <p>
                        <label for="modalidad">Modalidad de estudio:</label><br>
                        <select id="modalidad" name="modalidad" required>
                            <option value="">Selecciona una modalidad</option>
                            <option value="Presencial">Presencial</option>
                            <option value="Virtual">Virtual</option>
                        </select>
                    </p>

                    <p>
                        <label for="carrera">Carrera universitaria:</label><br>
                        <select id="carrera" name="carrera" required>
                            <option value="">Selecciona una carrera</option>
                            <option value="Desarrollo de Software">Desarrollo de Software</option>
                            <option value="Redes Informáticas">Redes Informáticas</option>
                            <option value="Ciberseguridad">Ciberseguridad</option>
                            <option value="Otra">Otra carrera</option>
                        </select>
                    </p>
                </fieldset>

                <fieldset>
                    <legend>Intereses tecnológicos</legend>
                    <input type="checkbox" id="interes-html" name="intereses" value="Diseño web">
                    <label for="interes-html">Diseño web</label><br>

                    <input type="checkbox" id="interes-bd" name="intereses" value="Bases de datos">
                    <label for="interes-bd">Bases de datos</label><br>

                    <input type="checkbox" id="interes-programacion" name="intereses" value="Programación">
                    <label for="interes-programacion">Programación</label>
                </fieldset>

                <p>
                    <label for="comentarios">Comentarios:</label><br>
                    <textarea id="comentarios" name="comentarios" rows="5" cols="40"
                              maxlength="500"
                              placeholder="Escribe aquí tus consultas o comentarios."></textarea>
                </p>

                <p>
                    <input type="checkbox" id="confirmacion" name="confirmacion" value="Aceptado" required>
                    <label for="confirmacion">Confirmo que los datos son de ejemplo y deseo continuar.</label>
                </p>

                <p>
                    <button type="submit">Enviar formulario</button>
                    <button type="reset">Restablecer formulario</button>
                </p>
            </form>
